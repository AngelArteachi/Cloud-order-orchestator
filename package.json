{
  "name": "cloud-order-orchestrator",
  "version": "1.0.0",
  "description": "Production-grade microservices backend using Node.js, TypeScript, Express, PostgreSQL, MongoDB, and Redis",
  "private": true,
  "workspaces": [
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:integration": "npm run test:integration --workspaces",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down -v"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
